# Copy to .dev.env and set your own paths. This file uses Bash syntax.
# These defaults preserve values supplied by the caller's environment.
GTL_JAVA_HOME="${GTL_JAVA_HOME:-/path/to/jdk-17}"
GTL_MODS_DIR="${GTL_MODS_DIR:-/path/to/minecraft/mods}"

# Use 0 to download build dependencies; use 1 after preparing the local cache.
GTL_OFFLINE="${GTL_OFFLINE:-0}"

# Server tests require explicit acceptance of https://aka.ms/MinecraftEULA.
GTL_ACCEPT_EULA="${GTL_ACCEPT_EULA:-false}"
